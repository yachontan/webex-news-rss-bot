# ============================================================
# regions.yml.example  —  時事ダイジェストの地域バランス設定テンプレート
#
# このファイルをコピーして `regions.yml` を作成する / Copy to `regions.yml`.
# デイリーダイジェスト（bots.yml の digest: true）の「時事ダイジェスト」枠で、
# 一般・世の中ニュースを地域バランス（日本 / 米国 / その他）で選ぶための設定。
# キーワード・クオータの正本を regions.yml に集約し、Python には直書きしない。
# このファイルが無い場合は、従来の「🇯🇵 日本のニュース（最低5件）」枠にフォールバックする。
# ============================================================

quota:
  japan: 7    # 日本（国内）— 目安。不足分の補充先=最優先
  us: 3       # 米国 — 上限（超えて補充しない）
  other: 5    # その他（米国以外の外国）

keywords:
  us:
    - アメリカ
    - 米国
    - トランプ
    - ワシントン
  other:
    - 中国
    - 韓国
    - ロシア
    - 欧州
# japan（国内）は上記いずれにも該当しない日本語ニュース。
