# ============================================================
# categories-private.yml
#
# 非公開キーワード設定ファイル / Private keyword overlay
#
# 役割: categories.yml (公開) を補完する、機密性のあるキーワードを定義。
# 動作: 実行時に load_categories() が categories.yml を読み込んだ後、
#       このファイルが存在すれば自動マージされる（既存カテゴリには追加、
#       新規カテゴリは追加生成）。
#
# 重要: このファイルは .gitignore に含めてリポジトリに含めない。
# Note:  This file must be listed in .gitignore. Never commit.
# ============================================================

${MYFAB_KEYWORD}:
  # ── ブランド名 / Brand names
  - "!${MYFAB_KEYWORD}"
  - "!${MYFAB_KEYWORD1}"
