# ============================================================
# bots.yml.example  —  マルチチャンネル（Bot）設定テンプレート
#
# このファイルで「どのWebexスペースに・どのカテゴリを送るか」を定義します。
# Define which Webex space receives which news categories.
#
# 使い方 / Usage:
# 1. このファイルをコピーして `bots.yml` を作成する / Copy to `bots.yml`
# 2. `bots.yml` を編集してWebexスペースIDとカテゴリを設定する
# ============================================================

channels:
  # チャンネル 1: AIニュース専用スペース
  - name: AI・機械学習ニュース
    # .env ファイルの環境変数を読み込む場合は ${変数名} と記述します
    webex_space_id: ${WEBEX_SPACE_ID_AI}
    # webex_bot_token: "${WEBEX_BOT_TOKEN_AI}" # 省略時はデフォルトの.envトークンを使用
    categories:
      - AI・機械学習

  # チャンネル 2: セキュリティ＆ネットワーク関連
  - name: セキュリティ & ネットワークニュース
    webex_space_id: your_security_space_id_here
    categories:
      - セキュリティ
      - ネットワーク
      - Cisco

  # チャンネル 3: 取得元 RSS フィードで振り分ける専用スペース（source_groups）
  #   categories（記事本文キーワード）ではなく「どのフィード由来か」で振り分ける。
  #   フィードURLは urls.yml の group: <名前> に定義し、ここでは名前だけを参照する
  #   （bots.yml に URL を書かない＝URL の正本は urls.yml に一本化）。
  #   指定グループ由来の記事はこのチャンネルが専有し、他チャンネルから除外される。
  #   例: Cisco Security Advisories を専用スペースへ隔離し、セキュリティ等への重複投稿を止める。
  #   webex_space_id / webex_bot_token が未設定（環境変数未解決）の間は自動でスキップされる。
  # - name: "News Today : Cisco Security Advisories"
  #   webex_space_id: ${WEBEX_SPACE_ID_CISCO_ADVISORY}
  #   webex_bot_token: ${WEBEX_BOT_TOKEN_CISCO_ADVISORY}
  #   priority: true
  #   source_groups:
  #     - cisco-advisory   # urls.yml の group: cisco-advisory を参照
  #   categories: []       # source_groups のみで振り分け

  # チャンネル 4: すべてのカテゴリを配信するダイジェスト
  # - name: 全カテゴリダイジェスト
  #   webex_space_id: ${WEBEX_SPACE_ID_DIGEST}
  #   categories: []   # 空 = 全カテゴリ
