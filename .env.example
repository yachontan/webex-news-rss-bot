# ==============================================================
# .env.example — 環境変数設定テンプレート / Environment variable template
#
# 使い方 / Usage:
#   cp .env.example .env
#   .env を開いて各値を設定してください。
#   Open .env and fill in your actual values.
#
# 重要 / Important:
#   .env は .gitignore により Git 管理対象外です。絶対にコミットしないでください。
#   .env is excluded by .gitignore. Never commit it to the repository.
# ==============================================================


# ==============================================================
# [必須] Webex Bot — シングルボットモード用 / Required for single-bot mode
# ==============================================================

# Webex Bot のアクセストークン / Webex Bot access token
# 取得方法: https://developer.webex.com/ → My Apps → Bot を作成
WEBEX_BOT_TOKEN=your_webex_bot_token_here

# 送信先 Webex スペース ID / Destination Webex Space ID
# 確認方法: check_rooms.py を実行してスペース一覧を取得
WEBEX_SPACE_ID=your_webex_space_id_here


# ==============================================================
# [任意] Webex Bot — マルチチャンネルモード用 / Optional for multi-channel mode (bots.yml)
# bots.yml で ${WEBEX_SPACE_ID_XXX} / ${WEBEX_BOT_TOKEN_XXX} を使う場合に設定。
# Set these if bots.yml references ${WEBEX_SPACE_ID_XXX} / ${WEBEX_BOT_TOKEN_XXX}.
# ==============================================================

WEBEX_SPACE_ID_GENERAL=your_general_space_id_here
WEBEX_SPACE_ID_AI=your_ai_space_id_here
WEBEX_SPACE_ID_SECURITY=your_security_space_id_here
WEBEX_SPACE_ID_NETWORKING=your_networking_space_id_here
WEBEX_SPACE_ID_ECONOMY=your_economy_space_id_here
WEBEX_SPACE_ID_CISCO=your_cisco_space_id_here

# News Today : Cisco Security Advisories 専用スペース（Cisco PSIRT RSS 由来を集約）
# 確認方法: python check_rooms.py --find "Cisco Security Advisories"
# 未設定の間、このチャンネルは自動的にスキップされます。
WEBEX_SPACE_ID_CISCO_ADVISORY=your_cisco_advisory_space_id_here

# デイリーダイジェスト専用スペース（天気＋各チャンネル投稿ニュースの集約／日本のニュース枠）
# 確認方法: python check_rooms.py --find "デイリーダイジェスト"
# 未設定の間、このチャンネルは自動的にスキップされます。
WEBEX_SPACE_ID_DIGEST=your_digest_space_id_here

# チャンネルごとに別 Bot トークンを使う場合のみ設定（省略時は WEBEX_BOT_TOKEN を共用）
# Set only if each channel uses a different Bot token (falls back to WEBEX_BOT_TOKEN)
# WEBEX_BOT_TOKEN_GENERAL=your_general_bot_token_here
# WEBEX_BOT_TOKEN_AI=your_ai_bot_token_here
# WEBEX_BOT_TOKEN_SECURITY=your_security_bot_token_here
# WEBEX_BOT_TOKEN_NETWORKING=your_networking_bot_token_here
# WEBEX_BOT_TOKEN_ECONOMY=your_economy_bot_token_here
# WEBEX_BOT_TOKEN_CISCO=your_cisco_bot_token_here
# WEBEX_BOT_TOKEN_CISCO_ADVISORY=your_cisco_advisory_bot_token_here
# WEBEX_BOT_TOKEN_DIGEST=your_digest_bot_token_here


# ==============================================================
# [任意] Anthropic (Claude) API — LLM 自動要約用 / Optional for LLM summarization
# 設定しない場合、要約はスキップされ元の RSS 概要をそのまま使用します。
# If not set, summarization is skipped and original RSS summaries are used.
# ==============================================================

# Anthropic API キー / Anthropic API key
# 取得方法: https://console.anthropic.com/
# 要約・再ランクを使う場合のみ、行頭の # を外して実際のキーを設定する。
# ダミー値のままだと毎回 API 呼び出しに失敗し警告が出る（動作はするが無駄なので）。
# Uncomment and set a real key only if you want LLM summaries / re-ranking.
# ANTHROPIC_API_KEY=<Anthropic Console で発行したキー（sk-ant- で始まる100文字ほどの文字列）>

# 使う AI を選ぶ / Which AI to use: anthropic（既定）/ openai / gemini
# LLM_PROVIDER=anthropic
# 選んだ AI に応じて、対応するキーだけを設定してください。
# OPENAI_API_KEY=<OpenAI で発行したキー（sk- で始まる文字列）>
# GEMINI_API_KEY=<Google AI Studio で発行したキー>

# 使用するモデル名 / Model to use（選んだ AI のモデル名を書く）
# 例 / e.g.: claude-haiku-4-5-20251001 / gpt-4o-mini / gemini-2.0-flash
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# ==============================================================
# [任意] SSL 検証設定 / Optional SSL verification
# 既定で false（社内プロキシや macOS の証明書問題を避けるため）。
# 証明書検証を有効にしたい場合は true に変更する。
# Defaults to false to avoid corporate-proxy / macOS certificate issues.
# ==============================================================

SSL_VERIFY=false


# ==============================================================
# [任意] プライベートカテゴリ用 環境変数 / Optional for private category (my-fab pattern)
# categories.yml や bots.yml で ${VAR} を使う場合に設定。
# Set if you use ${VAR} placeholders in categories.yml or bots.yml.
# 詳細は README「プライベートカテゴリ運用」セクションを参照。
# See README "Private Category Usage" section for details.
# ==============================================================

# categories.yml カテゴリ名・キーワードの変数化 / Variable substitution for category names/keywords
# MYFAB_KEYWORD=your_brand_name_here
# MYFAB_KEYWORD1=your_product_name_here
# MYFAB_KEYWORD2=your_alias_here
