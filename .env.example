# シングルボットモード用
WEBEX_BOT_TOKEN=your_webex_bot_token_here
WEBEX_SPACE_ID=your_webex_space_id_here

# ==========================================
# マルチチャンネルモード用 (bots.yml で参照する場合)
# ==========================================
WEBEX_SPACE_ID_AI=your_ai_space_id_here
WEBEX_SPACE_ID_SECURITY=your_security_space_id_here
# WEBEX_BOT_TOKEN_AI=your_ai_bot_token_here

# ==========================================
# categories.yml のカテゴリキーワード変数化用
# Variable substitution for categories.yml keywords (${VAR} in YAML)
# ==========================================
# my-fab カテゴリの必須キーワード（プライバシー保護のため .env で別管理）
# Categories.yml: "!${MYFAB_KEYWORD}" → runtime expanded to actual keyword
MYFAB_KEYWORD=my-fab
